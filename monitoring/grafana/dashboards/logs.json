{
  "uid": "jat-logs",
  "title": "Logs",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      { "name": "service", "label": "Service", "type": "custom",
        "query": "backend,frontend,db,prometheus,grafana,cadvisor",
        "includeAll": true, "multi": true, "allValue": ".*",
        "current": { "text": ["backend", "frontend", "db"], "value": ["backend", "frontend", "db"] }
      },
      { "name": "level", "label": "Niveau", "type": "custom",
        "query": "ERROR,FATAL,WARN,WARNING,INFO,LOG,DEBUG",
        "includeAll": true, "multi": true, "allValue": ".*",
        "current": { "text": "All", "value": "$__all" } },
      { "name": "search", "label": "Recherche", "type": "textbox", "query": "" }
    ]
  },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Lignes de log par niveau",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A",
        "expr": "sum by (level) (count_over_time({project=\"jat-staging\", service=~\"$service\", level=~\"$level\"} |= \"$search\" [1m]))",
        "legendFormat": "{{level}}" } ] },
    { "id": 2, "type": "logs", "title": "Logs",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [ { "refId": "A",
        "expr": "{project=\"jat-staging\", service=~\"$service\", level=~\"$level\"} |= \"$search\"" } ] }
  ]
}
# Sert le front compilé et redirige /api vers l'API Spring Boot.
# ${BACKEND_URL} est remplacé au démarrage du conteneur (envsubst de l'image nginx).
server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # Les appels /api partent vers le back : même origine, donc pas de CORS.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # $http_host garde le port (localhost:8080) : Spring voit la même origine que le navigateur
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Sonde de santé du front (utilisée par Kubernetes)
    location = /healthz {
        access_log off;
        return 200 'OK';
    }

    # Application React (single page) : toute URL inconnue renvoie index.html
    location / {
        try_files $uri /index.html;
    }
}